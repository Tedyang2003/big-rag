                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="1142" y="140" as="sourcePoint"/>
                        <mxPoint x="1192" y="90" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
